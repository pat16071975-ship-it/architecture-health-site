[Unit]
Description=AZ-BAZE authentication service
After=network.target

[Service]
Type=simple
User=azadmin
Group=www-data
WorkingDirectory=/opt/az-baze-auth
EnvironmentFile=/etc/az-baze/auth.env
ExecStart=/opt/az-baze-auth/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 --access-logfile - --error-logfile - server:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/az-baze

[Install]
WantedBy=multi-user.target
