# AZ-203 — PREPARED ONLY. DO NOT INSTALL OR ENABLE BEFORE APPROVAL.
# Uses the existing server-side token and the same Python sync core as
# "Загрузить данные Метрики и Директа". Never emulates a browser click.
[Unit]
Description=AZ BAZE combined Yandex Metrika and Direct hourly refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=azadmin
Group=www-data
WorkingDirectory=/opt/az-baze-auth
EnvironmentFile=/etc/az-baze/auth.env
ExecStart=/opt/az-baze-auth/venv/bin/python -B /opt/az-baze-auth/advertising_hourly.py
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/az-baze
