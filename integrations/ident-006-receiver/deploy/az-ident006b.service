[Unit]
Description=IDENT-006B isolated shadow receiver
Requires=az-ident006b.socket
After=az-ident006b.socket
StartLimitIntervalSec=0

[Service]
Type=simple
User=az-ident-recv
Group=az-ident-recv
WorkingDirectory=/opt/az-ident006b/app
Environment=IDENT_RECEIVER_CONFIG=/etc/az-ident006b/config.json
Environment=IDENT_RECEIVER_STATE_DIR=/var/lib/az-ident006b/state
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/az-ident006b/venv/bin/python -I -B /opt/az-ident006b/app/launch.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/az-ident006b/state
InaccessiblePaths=-/var/lib/az-baze -/etc/az-baze -/opt/az-baze-auth -/var/www
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LimitNOFILE=1024
TasksMax=32
MemoryMax=256M

[Install]
WantedBy=multi-user.target
